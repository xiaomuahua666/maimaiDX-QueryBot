[Unit]
Description=maimaiDX QueryBot auto-update supervisor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/bot/awmc
ExecStart=/www/bot/bot_supervisor.sh
Restart=always
RestartSec=5
TimeoutStopSec=35
KillMode=control-group

[Install]
WantedBy=multi-user.target
