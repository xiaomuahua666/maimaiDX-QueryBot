# ============================================================
# maimaiDX QueryBot 统一配置
# 查询、账号绑定、B50 上传、PC 与 BREAK 均在本插件内配置。
# 复制为 Bot 根目录的 .env 或 .env.prod 后填写。
# ============================================================

# ---------- QueryBot 必填 ----------
MAIMAIDXPATH=/absolute/path/to/static
MAIMAIDXTOKEN=diving_fish_developer_token

# ---------- AWMC 账号 / 上传服务 ----------
# team：自建 sw-api（需本机 keychip）；public：AWMC 公共网关（Bearer 令牌计费）。
# 文档：https://wiki.awmc.team/dev/awmc-api  平台：https://api.wmc.pub
#
# 【team 示例】
AWMC_API_MODE=team
AWMC_API_BASE_URL=http://127.0.0.1:5001
AWMC_PUBLIC_GATEWAY_TOKEN=
#
# 【public 示例】切换时请改 MODE，并设置令牌；BASE_URL 可留空（默认 https://api.wmc.pub）
# AWMC_API_MODE=public
# AWMC_API_BASE_URL=https://api.wmc.pub
# AWMC_PUBLIC_GATEWAY_TOKEN=gw_xxx
AWMC_API_TIMEOUT_SECONDS=120
AWMC_API_RETRY_COUNT=3
AWMC_API_RETRY_DELAY_SECONDS=1
AWMC_UPLOAD_POLL_INTERVAL_SECONDS=2
# 水鱼 / 落雪 B50 上传（update-fish / update-lx）单次 HTTP 超时（秒）。
AWMC_B50_UPLOAD_TIMEOUT_SECONDS=120
# 若上传响应仍带 task_id（旧网关）时的轮询上限；新版均为同步。
AWMC_UPLOAD_POLL_TIMEOUT_SECONDS=120
# 机台全量成绩（user/music）超时与重试；可比 B50 略长，但仍有硬上限。
AWMC_USER_MUSIC_TIMEOUT_SECONDS=15
AWMC_USER_MUSIC_RETRY_COUNT=0
# 本地 PC 成绩用于落雪 OAuth 直传的新鲜度（秒）；有缓存则跳过机台拉取。
AWMC_LXNS_PC_CACHE_SECONDS=600
# 等待全局机台锁最长时间（秒）；0=无限等待。超时提示机台繁忙。
AWMC_MACHINE_LOCK_TIMEOUT_SECONDS=60
# AWMC 账号 API 成功返回后的静默冷却（秒）。
AWMC_API_SUCCESS_COOLDOWN_SECONDS=1
# 发票允许倍率，英文逗号分隔。
AWMC_TICKET_ALLOWED_MULTIPLIERS=2,3,5
# 发票基础超时 120 秒；无历史时按每个待处理请求约 80 秒估算，之后改用近期真实耗时。
# 只轮询队列，队列成功后查一次票券库存，确认到账后才扣 BREAK。
AWMC_TICKET_POLL_INTERVAL_SECONDS=3
AWMC_TICKET_POLL_TIMEOUT_SECONDS=120
AWMC_TICKET_MAX_POLL_TIMEOUT_SECONDS=600
AWMC_TICKET_SECONDS_PER_REQUEST=80
# 队列 done 后等待 2 秒落库，随后只查一次 /user/charge。
AWMC_TICKET_SETTLEMENT_DELAY_SECONDS=2
AWMC_ACCOUNT_ENABLED=true
# 二维码缓存秒数；0=永久，重新 mai绑定 时更新。
AWMC_QRCODE_CACHE_SECONDS=0
# mymai/上传复用最近已验证 SGID 的秒数；0=每次都重新询问。
AWMC_SGID_CACHE_SECONDS=600
# 舞萌状态附带 Uptime Kuma 公开状态页（实时心跳/延迟/成功率）。
AWMC_STATUS_PAGE_BASE=https://status.awmc.cc
AWMC_STATUS_PAGE_SLUG=maimai
AWMC_FAILURE_RATE_URL=https://api.wmc.pub/usage/failure-rate
AWMC_STATUS_CACHE_SECONDS=30
AWMC_STATUS_TIMEOUT_SECONDS=8
# 自动扫描消息图片中的舞萌二维码；普通图片不会回复。
AWMC_IMAGE_QRCODE_ENABLED=true
# 单张图片最大下载字节数，默认 8 MiB。
AWMC_IMAGE_QRCODE_MAX_BYTES=8388608

# ---------- 管理审计 / WebUI ----------
# WebUI 默认独立监听 8099；启用或修改端口后需重启 Bot。
MAIMAIDX_ADMIN_WEB_ENABLED=false
# 至少 24 位高强度随机字符串，只通过 Authorization: Bearer 发送。
MAIMAIDX_ADMIN_WEB_TOKEN=replace_with_a_long_random_secret
# 独立 WebUI 监听地址/端口。本机反代推荐 127.0.0.1；Docker 跨容器可用 0.0.0.0。
MAIMAIDX_ADMIN_WEB_HOST=127.0.0.1
MAIMAIDX_ADMIN_WEB_PORT=8099
MAIMAIDX_ADMIN_WEB_PATH=/maimaidx/admin
# 用于「管理面板」指令展示完整地址，例如 https://bot.example.com
MAIMAIDX_ADMIN_WEB_PUBLIC_URL=
MAIMAIDX_AUDIT_RETENTION_DAYS=90
MAIMAIDX_MESSAGE_STATS_ENABLED=true
# 60 秒内前 30 个功能请求免费；第 31 个起每次额外收取 1 BREAK。
MAIMAIDX_BUSY_SURCHARGE_ENABLED=true
MAIMAIDX_BUSY_WINDOW_SECONDS=60
MAIMAIDX_BUSY_FREE_REQUESTS=30
MAIMAIDX_BUSY_SURCHARGE_BREAK=1
# 默认开启：合并连续回复，并省略可有可无的“处理中”提示。
MAIMAIDX_COMPACT_MESSAGES=true
# 开始处理时对触发消息贴的 QQ 表情 ID（NapCat set_msg_emoji_like）；空=关闭。
MAIMAIDX_PROCESSING_EMOJI_ID=424
MAIMAIDX_USER_AGREEMENT_REQUIRED=true
# 超级管理员迁移指令只允许读取该目录中的 Koishi 数据库/映射文件。
MAIMAIDX_KOISHI_MIGRATION_DIR=data/migration

# ---------- 统一数据存储：sqlite / yaml / mysql ----------
MAIMAIDX_STORAGE_BACKEND=sqlite
MAIMAIDX_STORAGE_NAMESPACE=default
MAIMAIDX_STORAGE_YAML_PATH=data/storage/state.yaml
MAIMAIDX_STORAGE_MYSQL_HOST=
MAIMAIDX_STORAGE_MYSQL_PORT=3306
MAIMAIDX_STORAGE_MYSQL_USER=
MAIMAIDX_STORAGE_MYSQL_PASSWORD=
MAIMAIDX_STORAGE_MYSQL_DATABASE=
MAIMAIDX_STORAGE_MYSQL_CHARSET=utf8mb4
MAIMAIDX_STORAGE_MYSQL_TABLE_PREFIX=maimaidx_
MAIMAIDX_STORAGE_MYSQL_SSL=false
MAIMAIDX_STORAGE_MYSQL_KEEP_SNAPSHOTS=3
# 仅检测变更；无变化时不会读取/打包数据库内容。0=只在启动/关机/手动时同步。
MAIMAIDX_STORAGE_SYNC_INTERVAL_SECONDS=900
MAIMAIDX_STORAGE_INCLUDE_USER_SCORES=true
MAIMAIDX_STORAGE_INCLUDE_PLAYER_CACHE=true
# auto=同一后端沿用本地缓存；remote=每次启动强制从持久化后端恢复。
MAIMAIDX_STORAGE_BOOTSTRAP_POLICY=auto
# 默认禁止在空 YAML/MySQL 上直接启动，要求先走管理员迁移。
MAIMAIDX_STORAGE_ALLOW_EMPTY_REMOTE_INIT=false
# true=配置、连接或校验失败时拒绝启动，防止误用旧数据。
MAIMAIDX_STORAGE_FAIL_FAST=true

# team 模式机台 keychip（public 模式由网关注入，无需填写）。
# 旧变量 SDGBTECHAPI 仍兼容，但推荐使用上面的 AWMC_API_BASE_URL。
SDGBT_CLIENT_ID=your_keychip

# ---------- 落雪查分查询（与“落雪导入 Token”不同） ----------
LXNS_DEV_TOKEN=
LX_CLIENT_ID=
LX_CLIENT_SECRET=
LX_REDIRECT_URI=

# ---------- 曲库与缓存 ----------
MAIMAIDX_DATA_SOURCE=
MAIMAIDX_DXDATA_PATH=dxdata.json
MAIMAIDX_MUSIC_CACHE_SECONDS=3600
MAIMAIDX_PLAYER_CACHE_SECONDS=900
MAIMAIDX_PLAYER_CACHE_USE_STORAGE=true
MAIMAIDX_PLAYER_STORAGE_FALLBACK_SECONDS=86400
# 段位表样本取最近 90 天全量成绩；实时统计缓存 5 分钟，单谱面少于 3 人时用内置样本兜底。
MAIMAIDX_RANK_COURSE_STATS_CACHE_SECONDS=300
MAIMAIDX_RANK_COURSE_SAMPLE_MAX_AGE_DAYS=90
MAIMAIDX_RANK_COURSE_SAMPLE_MAX_PLAYERS=5000
MAIMAIDX_RANK_COURSE_MIN_SAMPLES=3
MAIMAIDX_RATING_CACHE_SECONDS=900
MAIMAIDX_FRIEND_BATTLE_CACHE_SECONDS=604800
MAIMAIDX_FRIEND_BATTLE_COOLDOWN_SECONDS=180

# ---------- 平台 ----------
MAIMAIDX_PLATFORM=onebot
MAIMAIDX_USE_QQ_CARD=false
MAIMAIDX_BOT_ADMINS=

# ---------- 谱面标签 / 印象 ----------
DXRATING_TOKEN=
DXRATING_COMBINED_TAGS_URL=https://derrakuma.dxrating.net/functions/v1/combined-tags
PMYX_API_BASE_URL=http://103.45.162.66:37913

# ---------- B50 LLM 分析 ----------
B50_LLM_URL=https://api.openai.com/v1
B50_LLM_KEY=
B50_LLM_MODEL=gemini-3-flash-preview
B50_ASSETS_PATH=

# ---------- 猜铺面渲染并发（自适应） ----------
# 默认开启：按 load / 事件循环延迟动态调整 RENDER / BG_FILL / BATCH_SONGS。
# 忙时优先砍 BG_FILL 再砍 RENDER；闲时升到 MAX。勿再写死 BG_FILL=0。
MAIMAIDX_CHART_ADAPTIVE=1
MAIMAIDX_CHART_ADAPTIVE_INTERVAL=20
MAIMAIDX_CHART_ADAPTIVE_WARMUP=60
MAIMAIDX_CHART_RENDER_MIN=1
MAIMAIDX_CHART_RENDER_MAX=4
MAIMAIDX_CHART_BG_FILL_MIN=0
MAIMAIDX_CHART_BG_FILL_MAX=2
MAIMAIDX_CHART_BATCH_SONGS_MIN=1
MAIMAIDX_CHART_BATCH_SONGS_MAX=2
# load1/ncpu 阈值；也可沿用 MAIMAIDX_CHART_BG_FILL_LOAD_RATIO 作补洞暂停线
# MAIMAIDX_CHART_LOAD_IDLE=0.25
# MAIMAIDX_CHART_LOAD_ELEVATED=0.35
# MAIMAIDX_CHART_LOAD_BUSY=0.50
# MAIMAIDX_CHART_LOAD_CRIT=0.70
# MAIMAIDX_CHART_LAG_BUSY_MS=80
# MAIMAIDX_CHART_LAG_CRIT_MS=200
# 关闭自适应时可用固定值：
# MAIMAIDX_CHART_ADAPTIVE=0
# MAIMAIDX_CHART_RENDER_WORKERS=2
# MAIMAIDX_CHART_BG_FILL_WORKERS=1

# ---------- 其它 ----------
BOTNAME=maimai
MAIMAIDXPROBERPROXY=false
MAIMAIDXALIASPROXY=false
MAIMAIDXALIASPUSH=true
SAVEINMEM=true

# ---------- Kaggle 数据集上传（勿把真实 token 提交进 git）----------
# https://www.kaggle.com/settings/api → Generate New Token
# 推荐写在服务器 /www/bot/awmc/.env ，然后：
#   bash scripts/run_upload_kaggle.sh
# KAGGLE_API_TOKEN=KGAT_xxxxxxxx
# 可选：显式指定 owner（一般可从 token 自动解析）
# KAGGLE_USERNAME=your_kaggle_username
# 旧版 legacy key（不推荐）：
# KAGGLE_KEY=xxxxxxxx
